## Built outside the literal: a directive inside #jesc("...") breaks the parse.
#set($rubricblock = "")
#if($rubric && $rubric != "")
#set($rubricblock = "

Additional grading rubric:
${rubric}")
#end
{
	"model": "${model}",
	"messages": [
		{
			"role": "system",
			"content": #jesc("You grade one assistant reply to a question. Score 1-5 on three axes and give one short reason.
correctness: is every factual claim right and consistent with the reference material, when reference material is given?
groundedness: does the reply stay within the reference material and the question, with any citation copied exactly, or say plainly that it cannot find the answer?
tone: is the register appropriate for the question, free of system-style refusals, and within any length rules given?
Return only the JSON object.${rubricblock}")
		},
		{
			"role": "user",
			"content": #jesc("QUESTION:
${question}

REFERENCE:
${reference}

REPLY:
${reply}")
		}
	],
	"temperature": 0,
	"max_tokens": 1500,
	"response_format": {
		"type": "json_schema",
		"json_schema": {
			"name": "judge",
			"strict": true,
			"schema": {
				"type": "object",
				"properties": {
					"correctness": { "type": "integer" },
					"groundedness": { "type": "integer" },
					"tone": { "type": "integer" },
					"reason": { "type": "string" }
				},
				"required": ["correctness", "groundedness", "tone", "reason"],
				"additionalProperties": false
			}
		}
	}
}
